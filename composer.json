{
	"name": "flarum-lang/romanian",
	"description": "Romanian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/romanian",
	"license": "MIT",
	"authors": [
		{
			"name": "iorGian",
			"homepage": "https://github.com/iorGian",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/romanian/issues",
		"forum": "https://discuss.flarum.org/d/27531",
		"source": "https://github.com/flarum-lang/romanian"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Romanian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "ro",
			"title": "Română"
		}
	}
}
